# Generic runtime client folder (working copy with official base GRFs/exes) - not versioned
/client/

# Extracted base-game GRF content, kept locally for scanning/reference only
/Client_Reign/data_GRF/
/Client_Reign/rdata_GRF/

# Deployment credentials - never commit
/deploy.properties

# Written at deploy time by deploy.sh with the real DB password (see run_remote
# heredoc). Was previously tracked with placeholder content, which meant any git
# reset/checkout on the remote host silently wiped the live prod credentials back
# to that placeholder - caused repeated map-server DB auth outages.
/server/tools/docker/asset-prod/inter_conf.txt

# Java build output and frontend deps
/site/**/target/
/site/reign-site/prez/node_modules/
/site/reign-site/prez/node/
/site/reign-site/prez/.angular/
/site/reign-exposition/src/main/resources/static/
/site/app.log
/site/app-prod.log

# Curated RO client assets for zrenderer - large binaries, transferred separately (see deploy-zrenderer-resources.sh)
zren-resources/
zren-resources.tar.gz
site/zrenderer/secrets/
site/zrenderer/output/
zren-test/

# Generated patch archives (.thor) and plist.txt - built locally via mkpatch and
# published straight to the hosting server, never committed (same reasoning as the
# packed client/ folder: these are build output, not source)
/patcher/hosting/patches/
# Built rpatchur/mkpatch binaries - platform-specific build output
/patcher/dist/
