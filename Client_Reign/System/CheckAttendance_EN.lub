-- Last updated: 20230321
--
-- Reign of Midgard: kept in sync by hand with server/db/import-tmpl/attendance.yml -
-- the client has no protocol-level way to learn the server's real Start/End dates or
-- per-day reward items for this UI (confirmed: PACKET_ZC_UI_OPEN and the 0xAF0 claim
-- response only ever carry a day counter, never item/date data), so this local copy
-- is purely cosmetic preview data the admin must maintain manually. StartDate/EndDate
-- display month+day only (client format string has no year field at all).
-- Reward day 1-20 alternates Silver_Coin(675)/Gold_Coin(671) to match the real
-- server-side calendar (also alternating, days 1-200).

Config = {
	StartDate = 20260718,
	EndDate = 20290717
}
Reward = {
	{ 1, 675, 1 },
	{ 2, 671, 1 },
	{ 3, 675, 1 },
	{ 4, 671, 1 },
	{ 5, 675, 1 },
	{ 6, 671, 1 },
	{ 7, 675, 1 },
	{ 8, 671, 1 },
	{ 9, 675, 1 },
	{ 10, 671, 1 },
	{ 11, 675, 1 },
	{ 12, 671, 1 },
	{ 13, 675, 1 },
	{ 14, 671, 1 },
	{ 15, 675, 1 },
	{ 16, 671, 1 },
	{ 17, 675, 1 },
	{ 18, 671, 1 },
	{ 19, 675, 1 },
	{ 20, 671, 1 }
}
function main()
	result, msg = InsertCheckAttendanceConfig(Config.EvendOnOff, Config.StartDate, Config.EndDate)
	if not result then
		return false, msg
	end
	for k, rewardtbl in pairs(Reward) do
		result, msg = InsertCheckAttendanceReward(rewardtbl[1], rewardtbl[2], rewardtbl[3])
		if not result then
			return false, msg
		end
	end
	return true, "success"
end
